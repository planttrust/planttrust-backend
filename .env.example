# ─── Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — only .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────

# Server
PORT=3000

# Database
DATABASE_URL=postgres://planttrust:planttrust_dev@localhost:5432/planttrust

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-this-to-a-random-secret

# Vision AI (Module 1 Document OCR & Extraction / Module 4 Anti-Spoofing)
AI_VISION_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# XRPL Testnet (Module 5 — Blockchain)
XRPL_NETWORK=wss://s.altnet.rippletest.net:51233
XRPL_WALLET_SEED=your-xrpl-testnet-wallet-seed-here
