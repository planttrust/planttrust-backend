# Copy this file to .env:   Copy-Item .env.example .env
# Never commit .env

NODE_ENV=development
PORT=4000

# Matches the "db" service in docker-compose.yml
DATABASE_URL=postgresql://planttrust:planttrust@localhost:5433/planttrust

# Any long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the frontend runs
CORS_ORIGIN=http://localhost:3000
