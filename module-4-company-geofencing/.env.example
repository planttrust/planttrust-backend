# ─── Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — only .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────

# Server
PORT=3004

# Database
DATABASE_URL=postgres://planttrust:planttrust_dev@localhost:5432/planttrust

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-this-to-a-random-secret

# Module identity
MODULE_NAME=module-4

# Module 5 (Blockchain Audit) API
AUDIT_API_URL=http://localhost:3005/api/audit

# Module 2 (Marketplace) API — for escrow release trigger
MODULE_2_API_URL=http://localhost:3002/api
