{
  "info": {
    "name": "PlantTrust API",
    "description": "Requests for planttrust-backend. Choose the \"PlantTrust local\" environment, start the backend, and send \"API health\". Each module owner adds requests to their own folder and exports the collection back into postman/ in the same PR as the route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "description": "Is the backend running? Expects 200 { status: \"ok\" }."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "M1 Users",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/health",
            "description": "Is the M1 module mounted? Expects 200 { module, status }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/login",
            "description": "Logs in with demoEmail / demoPassword from the environment. The backend sets the httpOnly plantrust_session cookie; Postman keeps it and sends it with later requests. Returns 404 until M1 builds it in Sprint 1 (see contracts/m1-users.md)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('sets the session cookie', () => pm.expect(pm.cookies.has('plantrust_session')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me",
            "description": "The logged-in user { id, role, name }, or 401 when not logged in. Returns 404 until M1 builds it in Sprint 1 (see contracts/m1-users.md)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/logout",
            "description": "Clears the session cookie. Expects 204. Returns 404 until M1 builds it in Sprint 1 (see contracts/m1-users.md)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
